 def _append_text(container: ET.Element, last_child: ET.Element | None, text: str) -> None:
@@ -42,11 +43,26 @@ def _append_text(container: ET.Element, last_child: ET.Element | None, text: str
         last_child.tail = (last_child.tail or "") + text
 
 
+_INLINE_ITALIC_RE = re.compile(r"_([^_]+)_")
+
+
+def _append_inline_text(container: ET.Element, last_child: ET.Element | None, text: str) -> ET.Element | None:
+    cursor = 0
+    for match in _INLINE_ITALIC_RE.finditer(text):
+        _append_text(container, last_child, text[cursor : match.start()])
+        hi = ET.SubElement(container, _tei("hi"), {"rend": "italic"})
+        hi.text = match.group(1)
+        last_child = hi
+        cursor = match.end()
+    _append_text(container, last_child, text[cursor:])
+    return last_child
+
+
 def _append_collated_text(parent: ET.Element, text: CollatedText) -> None:
     last_child: ET.Element | None = None
     for segment in text.segments:
         if isinstance(segment, LiteralTokenSegment):
-            _append_text(parent, last_child, segment.text)
+            last_child = _append_inline_text(parent, last_child, segment.text)
             continue
         if isinstance(segment, ApparatusTokenSegment):
             app = ET.SubElement(parent, _tei("app"))
@@ -71,7 +87,7 @@ def _append_collated_line(
         return
 
     if isinstance(line, LiteralLine):
-        l_element.text = line.text
+        _append_inline_text(l_element, None, line.text)
         return
 
