+def test_pipeline_converts_underscore_italics_to_tei_hi() -> None:
+    from ets.core import run_pipeline_from_text
+    from ets.domain import EditionConfig, Witness
+
+    config = EditionConfig(
+        title="Test",
+        author="Auteur",
+        editor="Éditeur",
+        witnesses=[
+            Witness(siglum="A", year="1670", description="A"),
+            Witness(siglum="B", year="1671", description="B"),
+        ],
+        reference_witness=0,
+    )
+    input_text = """####ACTE I####
+####ACTE I####
+
+###SCENE I###
+###SCENE I###
+
+##ORESTE##
+##ORESTE##
+
+#ORESTE#
+#ORESTE#
+
+Oui je viens en son _temple_ adorer l’Eternel
+Oui je viens en son _temple_ adorer l’Eternel
+"""
+
+    root = _parse(run_pipeline_from_text(input_text, config))
+    line = _line(root, "1")
+    italic = line.find("tei:hi[@rend='italic']", NS)
+
+    assert italic is not None
+    assert italic.text == "temple"
+    assert "_" not in "".join(line.itertext())
