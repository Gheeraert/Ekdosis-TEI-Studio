default namespace = "http://www.tei-c.org/ns/1.0"
namespace xml = "http://www.w3.org/XML/1998/namespace"
datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

start = TEI

TEI =
  element TEI {
    attribute xml:lang { "fr" }?,
    teiHeader,
    playText
  }

teiHeader =
  element teiHeader {
    element fileDesc {
      titleStmt,
      publicationStmt,
      sourceDesc
    },
    encodingDesc
  }

titleStmt =
  element titleStmt {
    element title { text },
    element author { text },
    editor?,
    respStmt*
  }

editor =
  element editor {
    attribute role { "scientific" },
    text
  }

respStmt =
  element respStmt {
    element resp { text },
    element name { attribute role { "transcriber" }?, text }
  }

publicationStmt =
  element publicationStmt {
    element p { text }
  }

sourceDesc =
  element sourceDesc {
    listWit | p
  }

p =
  element p { text }

listWit =
  element listWit {
    witness+
  }

witness =
  element witness {
    attribute xml:id { xsd:ID },
    attribute ana { "#witness_documentary" | "#witness_editorial" }?,
    text
  }

encodingDesc =
  element encodingDesc {
    schemaRef+,
    classDecl?
  }

schemaRef =
  element schemaRef {
    attribute key { "ets-racine" | "ets-racine-rnc" | "ets-racine-sch" },
    attribute type { "projectODD" | "validationRNC" | "validationSchematron" },
    attribute url { text },
    element desc { text }?
  }

classDecl =
  element classDecl {
    taxonomy+
  }

taxonomy =
  element taxonomy {
    attribute xml:id { "ets-variant-taxonomy" | "ets-witness-taxonomy" },
    category+
  }

category =
  element category {
    attribute xml:id { text },
    element catDesc { text }
  }

playText =
  element text {
    attribute xml:id { xsd:ID },
    front?,
    body
  }

# <front> ne couvre pas le front matter TEI general (notices, introduction,
# bibliographie) : il ne couvre que le bloc technique de dramatis personae
# produit par build_castlist_tei_element().
front =
  element front {
    dramatisPersonaeDiv
  }

dramatisPersonaeDiv =
  element div {
    attribute type { "dramatis-personae" },
    head?,
    castList,
    settingStage?
  }

castList =
  element castList {
    castItem+
  }

castItem =
  element castItem {
    attribute xml:id { xsd:ID },
    element role { text },
    element roleDesc { text }?,
    note
  }

note =
  element note {
    attribute type { "semi-diplomatic" },
    mixed { inline* }
  }

settingStage =
  element stage {
    attribute type { "setting" },
    mixed { inline* }
  }

body =
  element body {
    bodyDiv+
  }

# actDiv et prologueDiv doivent rester une seule et meme definition
# "element div { A | B }" : deux regles nommees separement, combinees par un
# choix au niveau de body, ne sont pas deterministes pour la plupart des
# moteurs RelaxNG (dont libxml2), qui echouent alors a valider le second
# <div> rencontre. L'ordre reel (prologue avant les actes, au plus un
# prologue) est verifie par ets-racine.sch, pas par cette grammaire.
bodyDiv =
  element div {
    actContent | prologueContent
  }

actContent =
  attribute type { "act" },
  attribute n { text },
  attribute xml:id { xsd:ID },
  head,
  sceneDiv+

# Un prologue est une division de tete de piece : pas de scene imbriquee,
# pas d'attribut @n (voir generator.py, is_prologue=True).
prologueContent =
  attribute type { "prologue" },
  attribute xml:id { xsd:ID },
  head,
  personnagesStage?,
  explicitStage*,
  sp+

sceneDiv =
  element div {
    attribute type { "scene" },
    attribute n { text },
    attribute xml:id { xsd:ID },
    head,
    personnagesStage?,
    explicitStage*,
    sp+
  }

head = element head { mixed { inline* } }

personnagesStage =
  element stage {
    attribute type { "personnages" },
    mixed { inline* }
  }

explicitStage =
  element stage {
    attribute xml:id { xsd:ID },
    mixed { inline* }
  }

implicitStage =
  element stage {
    attribute type { "DI" },
    attribute xml:id { xsd:ID },
    attribute ana {
      "#SPC" | "#ASP" | "#TMP" | "#EVT" | "#SET" | "#PROX" | "#ATT" | "#VOI"
    },
    l+
  }

sp =
  element sp {
    attribute who { text }?,
    speaker,
    (l | lg | explicitStage | implicitStage)+
  }

speaker = element speaker { mixed { inline* } }

lg =
  element lg {
    attribute type { "stanza" },
    attribute subtype { text }?,
    attribute rhyme { text }?,
    l+
  }

l =
  element l {
    attribute n { text },
    attribute xml:id { xsd:ID },
    attribute met { text }?,
    attribute part { "I" | "M" | "F" }?,
    mixed { inline* }
  }

inline = app | hi

readingInline = hi

app =
  element app {
    (minorAppAttributes | empty),
    lem,
    rdg+
  }

minorAppAttributes =
  attribute type { "minor" },
  attribute subtype {
    "graphic" | "punctuation" | "mixed" | "case" | "spacing" | "identical"
  },
  attribute ana { text },
  attribute cert { "low" }?

lem =
  element lem {
    attribute wit { text },
    attribute type { "omission" }?,
    mixed { readingInline* }
  }

rdg =
  element rdg {
    attribute wit { text },
    attribute type { "omission" }?,
    mixed { readingInline* }
  }

hi =
  element hi {
    attribute rend { "italic" },
    mixed { inline* }
  }
