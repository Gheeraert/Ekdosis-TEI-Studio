--- ui_base/tests/test_minor_variants.py	2026-06-07 19:15:22.251794227 +0000
+++ ets7/tests/test_minor_variants.py	2026-06-07 19:14:56.126262918 +0000
@@ -157,3 +157,105 @@
     readable = tei_to_ekdosis(xml, apparatus_policy="hide_minor")
 
     assert "\\app{" in readable
+
+from ets.application import (
+    SitePublicationDialogConfig,
+    SitePublicationDialogPlayConfig,
+    load_site_publication_dialog_config,
+    save_site_publication_dialog_config,
+)
+from ets.publication_pdf import build_publication_pdf_master
+
+
+def _write_publication_dramatic_xml(path):
+    path.write_text(
+        '''<?xml version="1.0" encoding="UTF-8"?>
+<TEI xmlns="http://www.tei-c.org/ns/1.0">
+  <teiHeader>
+    <fileDesc>
+      <titleStmt><title>Pièce test</title><author>Jean Racine</author></titleStmt>
+      <publicationStmt><p>Test</p></publicationStmt>
+      <sourceDesc><p>Test</p></sourceDesc>
+    </fileDesc>
+    <encodingDesc>
+      <listWit>
+        <witness xml:id="A"><bibl>A (1664) A</bibl></witness>
+        <witness xml:id="B"><bibl>B (1676) B</bibl></witness>
+      </listWit>
+    </encodingDesc>
+  </teiHeader>
+  <text>
+    <body>
+      <div type="act" n="1">
+        <div type="scene" n="1">
+          <sp>
+            <speaker>ORESTE</speaker>
+            <l n="1"><app type="minor" subtype="graphic" ana="#i_j"><lem wit="#A">Ie </lem><rdg wit="#B">Je </rdg></app>viens.</l>
+            <l n="2">Il faut <app><lem wit="#A">partir.</lem><rdg wit="#B">mourir.</rdg></app></l>
+          </sp>
+        </div>
+      </div>
+    </body>
+  </text>
+</TEI>
+''',
+        encoding="utf-8",
+    )
+    return path
+
+
+def test_publication_pdf_master_can_hide_minor_variants(tmp_path) -> None:
+    dramatic = _write_publication_dramatic_xml(tmp_path / "piece.xml")
+    config = SitePublicationDialogConfig(
+        author_name="Jean Racine",
+        corpus_title="Corpus test",
+        output_dir=tmp_path / "site",
+        hide_minor_variants_in_pdf=True,
+        plays=(
+            SitePublicationDialogPlayConfig(
+                play_slug="piece",
+                dramatic_xml_path=dramatic,
+            ),
+        ),
+    )
+
+    master_text = build_publication_pdf_master(config, tmp_path / "build").read_text(encoding="utf-8")
+
+    assert r"\app{\lem[wit={A}]{Ie}\rdg[wit={B}]{Je}}" not in master_text
+    assert "Ie viens." in master_text
+    assert r"\app{\lem[wit={A}]{partir.}\rdg[wit={B}]{mourir.}}" in master_text
+
+
+def test_publication_pdf_master_keeps_minor_variants_by_default(tmp_path) -> None:
+    dramatic = _write_publication_dramatic_xml(tmp_path / "piece.xml")
+    config = SitePublicationDialogConfig(
+        author_name="Jean Racine",
+        corpus_title="Corpus test",
+        output_dir=tmp_path / "site",
+        plays=(
+            SitePublicationDialogPlayConfig(
+                play_slug="piece",
+                dramatic_xml_path=dramatic,
+            ),
+        ),
+    )
+
+    master_text = build_publication_pdf_master(config, tmp_path / "build").read_text(encoding="utf-8")
+
+    assert r"\app{\lem[wit={A}]{Ie}\rdg[wit={B}]{Je}}" in master_text
+    assert r"\app{\lem[wit={A}]{partir.}\rdg[wit={B}]{mourir.}}" in master_text
+
+
+def test_publication_dialog_config_preserves_hide_minor_pdf_option(tmp_path) -> None:
+    config_path = tmp_path / "publication_config.json"
+    config = SitePublicationDialogConfig(
+        author_name="Jean Racine",
+        corpus_title="Corpus test",
+        output_dir=tmp_path / "site",
+        hide_minor_variants_in_pdf=True,
+    )
+
+    save_site_publication_dialog_config(config, config_path)
+    loaded = load_site_publication_dialog_config(config_path)
+
+    assert loaded.hide_minor_variants_in_pdf is True
