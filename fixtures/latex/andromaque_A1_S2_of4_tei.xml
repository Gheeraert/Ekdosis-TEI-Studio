        <rdg wit="#D">sçai </rdg>
      </app>
point 
      <app>
        <lem wit="#C #D #E #F">prévoir </lem>
        <rdg wit="#A #B">préuoir </rdg>
      </app>
les 
      <app>
        <lem wit="#A #D #E #F">malheurs </lem>
        <rdg wit="#B #C">maheurs </rdg>
      </app>
de si loin. </l>

<l n="197">

      <app>
        <lem wit="#C #D #E #F">Je </lem>
        <rdg wit="#A #B">Ie </rdg>
      </app>
songe quelle 
      <app>
        <lem wit="#A #B #C #E #F">estoit </lem>
        <rdg wit="#D">étoit </rdg>
      </app>
autrefois cette 
      <app>
        <lem wit="#A #B #C #F">Ville, </lem>
        <rdg wit="#D #E">Ville. </rdg>
      </app>
</l>

<l n="198">
Si 
