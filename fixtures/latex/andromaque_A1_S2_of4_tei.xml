        <lem wit="#A #B #C #F">des </lem>
        <rdg wit="#D #E">d’un </rdg>
      </app>

      <app>
        <lem wit="#A #B #C #F">Captifs </lem>
        <rdg wit="#D #E">Captif </rdg>
      </app>
que le 
      <app>
        <lem wit="#A #B #C #F">Sort </lem>
        <rdg wit="#D #E">sort </rdg>
      </app>
m’a 
      <app>
        <lem wit="#A #B #F">soûmis&#160;? </lem>
