jour ne renaisse&#160;: </l>

<l n="194">
Son Fils peut me 
      <app>
        <lem wit="#C #D #E #F">ravir </lem>
        <rdg wit="#A #B">rauir </rdg>
      </app>
le jour que 
      <app>
        <lem wit="#C #D #E #F">je </lem>
        <rdg wit="#A #B">ie </rdg>
      </app>

      <app>
