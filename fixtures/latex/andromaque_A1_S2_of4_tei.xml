      </app>

      <app>
        <lem wit="#A #B #F">laisse&#160;: </lem>
        <rdg wit="#C #D #E">laisse. </rdg>
      </app>
</l>

<l n="195">
Seigneur, tant de prudence 
      <app>
        <lem wit="#A #B #C #D #F">entraisne </lem>
        <rdg wit="#E">entraîne </rdg>
      </app>
trop de soin. </l>

<l n="196">

      <app>
        <lem wit="#C #D #E #F">Je </lem>
        <rdg wit="#A #B">Ie </rdg>
      </app>
ne 
      <app>
