        <rdg wit="#D #E">soûmis. </rdg>
      </app>
</l>

<l n="185">

      <app>
        <lem wit="#A #B #F">Oüy, </lem>
        <rdg wit="#C #E">Ouy, </rdg>
        <rdg wit="#D">Oüi, </rdg>
      </app>
Seigneur, lors&#160;qu’au 
