      </app>
si fertile, </l>

<l n="199">
Maistresse de l’Asie, &amp; 
      <app>
        <lem wit="#C #D #E #F">je </lem>
        <rdg wit="#A #B">ie </rdg>
      </app>
regarde enfin </l>

<l n="200">
Quel fut le 
      <app>
        <lem wit="#A #B #C #D #F">Sort </lem>
        <rdg wit="#E">sort </rdg>
      </app>
de Troye, &amp; quel est son 
      <app>
        <lem wit="#A #B #C #D #F">Destin. </lem>
        <rdg wit="#E">destin. </rdg>
      </app>
</l>

<l n="201">

      <app>
        <lem wit="#C #D #E #F">Je </lem>
        <rdg wit="#A #B">Ie </rdg>
      </app>
ne 
      <app>
        <lem wit="#A #B #C #E #F">voy </lem>
        <rdg wit="#D">voi </rdg>
