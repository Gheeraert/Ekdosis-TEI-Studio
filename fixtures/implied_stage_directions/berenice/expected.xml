        <div type="scene" n="1" xml:id="berenice-A1S1">
          <head>SCENE PREMIERE.</head>
          <stage type="personnages">ANTIOCHUS, ARSACE.</stage>
          <sp>
            <speaker>ANTIOCHUS.</speaker>
            <stage type="DI" ana="#SET" xml:id="berenice-implicite1">
              <l n="1" xml:id="berenice-A1S1L1">ARRESTONS un moment. La pompe de ces Lieux,</l>
              <l n="2" xml:id="berenice-A1S1L2">Je le <app type="minor" subtype="graphic" ana="#u_v #y_i">
                  <lem wit="#A #B #E">voy </lem>
                  <rdg wit="#C #D">voi </rdg>
                </app>bien, Arsace, est nouvelle à tes yeux.</l>
              <l n="3" xml:id="berenice-A1S1L3">Souvent ce Cabinet superbe <app>
                  <lem wit="#A #C #D #E">&amp; </lem>
                  <rdg wit="#B">é </rdg>
                </app>solitaire,</l>
              <l n="4" xml:id="berenice-A1S1L4">Des secrets de Titus est le dépositaire.</l>
              <l n="5" xml:id="berenice-A1S1L5">C'est <app type="minor" subtype="graphic" ana="#y_i">
                  <lem wit="#A #B #E">icy </lem>
                  <rdg wit="#C #D">ici </rdg>
                </app>quelquefois qu'il se cache à sa Cour,</l>
              <l n="6" xml:id="berenice-A1S1L6">Lors qu'il vient à la <app type="minor" subtype="graphic" ana="#y_i">
                  <lem wit="#A #B #E">Reyne </lem>
                  <rdg wit="#C #D">Reine </rdg>
                </app>expliquer son amour.</l>
              <l n="7" xml:id="berenice-A1S1L7">De son <app type="minor" subtype="graphic" ana="#double_consonant">
                  <lem wit="#A #B #C #E">Apartement </lem>
                  <rdg wit="#D">appartement </rdg>
                </app>cette porte est prochaine,</l>
              <l n="8" xml:id="berenice-A1S1L8">Et cette autre conduit dans <app type="minor" subtype="graphic" ana="#y_i">
                  <lem wit="#A #B #D #E">celuy </lem>
                  <rdg wit="#C">celui </rdg>
                </app>de la <app type="minor" subtype="mixed" ana="#punctuation_only #punctuation_removed_for_graphic_key #y_i">
                  <lem wit="#A #E">Reyne.</lem>
                  <rdg wit="#B">Reyne,</rdg>
                  <rdg wit="#C">Reine,</rdg>
                  <rdg wit="#D">Reine.</rdg>
                </app>
              </l>
            </stage>
            <stage type="DI" ana="#EVT" xml:id="berenice-implicite2">
              <l n="9" xml:id="berenice-A1S1L9">Va <app type="minor" subtype="graphic" ana="#accent #final_zx_s">
                  <lem wit="#A #B #D #E">chez </lem>
                  <rdg wit="#C">chés </rdg>
                </app>elle. <app type="minor" subtype="graphic" ana="#spacing_or_hyphen #y_i">
                  <lem wit="#A #B #E">Dy-luy </lem>
                  <rdg wit="#C">Di-lui </rdg>
                  <rdg wit="#D">Di-luy </rdg>
                </app>qu'importun à regret,</l>
            </stage>
            <l n="10" xml:id="berenice-A1S1L10">J'ose <app type="minor" subtype="graphic" ana="#y_i">
                <lem wit="#A #B #D #E">luy </lem>
                <rdg wit="#C">lui </rdg>
              </app>demander un entretien secret.</l>
          </sp>
        </div>
      </div>
