+def test_classifies_ultra_prudent_v8_spellings_as_hide_safe_minor() -> None:
+    examples = [
+        ("bien-tost,", ["bien-tôt,"]),
+        ("temps", ["tems"]),
+        ("doy", ["doi", "dois"]),
+        ("sceût", ["sçût"]),
+        ("pieds", ["piez"]),
+        ("condamnée,", ["condannée,"]),
+        ("Espoux", ["Epoux"]),
+        ("avoürez", ["avoüerez", "avoüerés", "avoûrez"]),
+        ("s’assure", ["s’asseure"]),
+        ("j’étois", ["j’estois"]),
+        ("fay", ["fai", "fais"]),
+        ("Sache", ["Sçache"]),
+        ("pour", ["ponr"]),
+        ("SCENE", ["SCENE."]),
+    ]
+
+    for lemma, readings in examples:
+        classification = classify_apparatus(lemma, readings)
+        assert classification.visibility_policy == "hide_safe", (lemma, readings, classification)
+        assert classification.candidate_class in {
+            "minor_graphic_safe",
+            "minor_punctuation",
+            "minor_mixed",
+        }, (lemma, readings, classification)
+
+
+def test_keeps_v8_forbidden_substantive_examples_visible() -> None:
+    examples = [
+        ("portast", ["porta", "portât"]),
+        ("Allez", ["Daignés", "Daignez"]),
+        ("ses", ["ces"]),
+        ("sa", ["ma"]),
+        ("Tant que l’on", ["Tandis qu’on"]),
+        ("aux grandeurs,", ["à l’Empire,"]),
+        ("qu’écarte", ["que glace"]),
+        ("éloigne", ["écarte"]),
+    ]
+
+    for lemma, readings in examples:
+        classification = classify_apparatus(lemma, readings)
+        assert classification.visibility_policy == "visible", (lemma, readings, classification)
+
